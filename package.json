{
  "name": "mest",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "server"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:server": "npm run dev -w server",
    "dev:all": "npm run dev:server & npm run dev; wait",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b && tsc -p server --noEmit",
    "test:server": "vitest run --config server/vitest.config.ts",
    "e2e": "playwright test",
    "migrate": "tsx server/src/cli/migrate.ts",
    "seed": "tsx server/seed/seed.ts",
    "job": "tsx server/src/jobs/index.ts",
    "admin:grant": "tsx server/src/cli/admin-grant.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.11",
    "@hookform/resolvers": "5.9.2",
    "@tanstack/react-query": "5.108.4",
    "arctic": "3.7.0",
    "gsap": "3.15.0",
    "hono": "4.13.21",
    "lucide-react": "0.468.0",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.92.0",
    "react-router": "7.18.6",
    "resend": "6.39.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "esbuild": "0.28.2",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.8.3",
    "vite": "6.4.4",
    "vitest": "3.2.7"
  }
}
