# Copy to .env for local development. Every value here has a local default
# that works with `docker compose up -d`; only the optional ones change behaviour.

# Postgres (docker-compose.yml exposes the local instance on 54329)
DATABASE_URL=postgres://mest:mest@127.0.0.1:54329/mest
# The test harness replaces the database name with mest_test_<WORKTREE_ID>
DATABASE_URL_TEST=postgres://mest:mest@127.0.0.1:54329/mest_test
# The API's request pool logs in as mest_request (created by migration 0001),
# so a request can never RESET ROLE back to the owner. Locally this is derived
# from DATABASE_URL; in production set it, with the password you gave the role:
#   ALTER ROLE mest_request PASSWORD '...';
REQUEST_DATABASE_URL=

# Where the app is served from; used for links in email and the Origin check
APP_ORIGIN=http://127.0.0.1:8787

# At least 32 characters. Rotate per the runbook.
SESSION_SECRET=change-me-to-a-random-string-of-32-or-more-characters

# Email. Without RESEND_API_KEY the outbox sender prints the message text to
# the server log instead of sending (that is how a local magic link is read).
EMAIL_FROM="MEST Network <network@example.test>"
# RESEND_API_KEY=

# Google sign-in is hidden until both values are set.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

PORT=8787
NODE_ENV=development

# Background jobs (expiry, reminders, email sending). Railway sets this to true.
JOBS_ENABLED=false

# Read X-Forwarded-For for rate limits. Only behind a trusted proxy (Railway).
TRUST_PROXY=false
# Trusted proxies that append to X-Forwarded-For; confirm against Railway's headers.
TRUST_PROXY_HOPS=1
